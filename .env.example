MODEL_DIR=./models
OUTPUT_DIR=./outputs

PREVIEW_MODEL=cogvideox-2b
FINAL_MODEL=cogvideox-5b-i2v

DEVICE=cuda
DTYPE=float16

ENABLE_CPU_OFFLOAD=true
ENABLE_VAE_TILING=true
ENABLE_VAE_SLICING=true

DATABASE_URL=sqlite:///./movie_studio.db

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4000
